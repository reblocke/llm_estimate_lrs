{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rights and licenses registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_status",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "review_status": {
      "enum": [
        "PENDING_HUMAN_RIGHTS_REVIEW",
        "reviewed"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "reviewed"
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "items": {
              "properties": {
                "redistribution_decision": {
                  "enum": [
                    "approved",
                    "prohibited"
                  ]
                },
                "owner_or_source": {
                  "$ref": "#/$defs/reviewed_text"
                },
                "license_or_terms": {
                  "$ref": "#/$defs/reviewed_text"
                },
                "permitted_use_summary": {
                  "$ref": "#/$defs/reviewed_text"
                },
                "attribution_requirement": {
                  "$ref": "#/$defs/reviewed_text"
                },
                "approval_authority": {
                  "$ref": "#/$defs/reviewed_text"
                },
                "unresolved_risk": {
                  "const": false
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "reviewed_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "pattern": "(?:^|[^A-Za-z0-9])(?:[Pp][Ee][Nn][Dd][Ii][Nn][Gg]|[Uu][Nn][Rr][Ee][Ss][Oo][Ll][Vv][Ee][Dd]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Tt][Bb][Dd]|[Tt][Oo][Dd][Oo]|[Uu][Nn][Aa][Ss][Ss][Ii][Gg][Nn][Ee][Dd]|[Nn][Oo][Tt][ _-]+[Aa][Ss][Ss][Ii][Gg][Nn][Ee][Dd])(?:$|[^A-Za-z0-9])"
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_id",
        "artifact",
        "content_class",
        "owner_or_source",
        "access_class",
        "license_or_terms",
        "redistribution_decision",
        "permitted_use_summary",
        "attribution_requirement",
        "approval_authority",
        "approval_date",
        "unresolved_risk"
      ],
      "properties": {
        "rights_id": {
          "type": "string",
          "pattern": "^RIGHTS-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "artifact": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "content_class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "owner_or_source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "access_class": {
          "enum": [
            "generated",
            "open",
            "public"
          ]
        },
        "license_or_terms": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "redistribution_decision": {
          "enum": [
            "approved",
            "pending",
            "prohibited"
          ]
        },
        "permitted_use_summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "attribution_requirement": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "approval_authority": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "approval_date": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "unresolved_risk": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "redistribution_decision": {
                "const": "pending"
              }
            },
            "required": [
              "redistribution_decision"
            ]
          },
          "then": {
            "properties": {
              "approval_date": {
                "type": "null"
              },
              "unresolved_risk": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "redistribution_decision": {
                "const": "approved"
              }
            },
            "required": [
              "redistribution_decision"
            ]
          },
          "then": {
            "properties": {
              "approval_date": {
                "type": "string",
                "format": "date"
              },
              "owner_or_source": {
                "$ref": "#/$defs/reviewed_text"
              },
              "license_or_terms": {
                "$ref": "#/$defs/reviewed_text"
              },
              "permitted_use_summary": {
                "$ref": "#/$defs/reviewed_text"
              },
              "attribution_requirement": {
                "$ref": "#/$defs/reviewed_text"
              },
              "approval_authority": {
                "$ref": "#/$defs/reviewed_text"
              },
              "unresolved_risk": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
